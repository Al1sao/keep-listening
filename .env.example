# Copiar a .env y completar. NO versionar el .env real.

# Obligatoria fuera de DEBUG. Generar con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=cambiame-por-una-clave-larga-y-aleatoria

# 1 = desarrollo (trazas de error visibles), 0 = producción
DJANGO_DEBUG=1

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Ruta del archivo SQLite dentro del contenedor (coincide con docker-compose.yml)
SQLITE_PATH=/app/datos/db.sqlite3

# ---------------------------------------------------------------------------
# Entrar con plataformas (opcional). Cada una se activa al completar sus claves.
# En la consola de cada plataforma, la URL de retorno (redirect URI) es:
#   http://localhost:8000/auth/<plataforma>/login/callback/
# con <plataforma> = spotify, apple, google, soundcloud
# (en producción, con https y tu dominio).
# ---------------------------------------------------------------------------
# Spotify: developer.spotify.com/dashboard
KL_SPOTIFY_ID=
KL_SPOTIFY_SECRET=
# Apple Music (Sign in with Apple): developer.apple.com > Identifiers (Service ID) y Keys
KL_APPLE_ID=            # Service ID, por ejemplo com.tudominio.keeplistening
KL_APPLE_SECRET=        # Key ID de la clave .p8
KL_APPLE_TEAM=          # Team ID
KL_APPLE_PRIVATE_KEY=   # contenido del .p8 en una línea, con \n donde van los saltos
# YouTube Music (cuenta de Google): console.cloud.google.com > APIs y servicios > Credenciales
KL_GOOGLE_ID=
KL_GOOGLE_SECRET=
# SoundCloud: soundcloud.com/you/apps
KL_SOUNDCLOUD_ID=
KL_SOUNDCLOUD_SECRET=

# --- Publicación (ver render.yaml; en local no hacen falta) -----------------
# DATABASE_URL=postgresql://usuario:clave@host:5432/keep_listening
# KL_DEMO=1                 # carga los datos de ejemplo aunque DJANGO_DEBUG=0
# KL_ADMIN_PASSWORD=        # contraseña del admin en la demo publicada
# KL_SERVIDOR=gunicorn      # sirve con gunicorn en el puerto PORT
# KL_SERVIR_MEDIA=1         # Django sirve los archivos subidos (sin nginx)
# KL_PROXIES=1              # proxies de confianza delante (IP real)
# KL_CACHE_DIR=             # carpeta de la caché del catálogo
